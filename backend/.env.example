# Sri Vasavi Textiles ERP - Backend Environment Variables

APP_NAME="Sri Vasavi Textiles ERP"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sri_vasavi_textiles

# JWT Authentication
# Generate a strong secret in production: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-super-secret-jwt-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# File Uploads & Backups
UPLOAD_DIR=uploads
BACKUP_DIR=backups
MAX_UPLOAD_SIZE_MB=10

